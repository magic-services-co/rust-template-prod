APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
STORAGE_PUBLIC_URL=https://template.vinnip.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Use same MySQL as frontend (see frontend .env DATABASE_URL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=templatephp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# When frontend is on a public domain (e.g. template.vinnip.com) and API is proxied, set this so the session cookie is sent on OAuth callback.
# Example: SESSION_DOMAIN=template.vinnip.com
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# License server (external API to get user license info). Do NOT put the API key in .env.
# Store it in a file instead: create backend/storage/app/.license_server_api_key with your key on one line.
# Optional: base URL of your license API (e.g. https://license.example.com)
# LICENSE_SERVER_URL=
# Optional: public hostname for domain-locked licenses when API requests use an internal Host
# LICENSE_PUBLIC_HOST=

# Discord (OAuth + bot for admin guild/role associations)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=
# Bot token required for "Reload" on Discord Server / Discord Role in Roles settings
# DISCORD_BOT_TOKEN=

# Optional: API key for creating support tickets with discordUserId (e.g. Discord bot)
# SUPPORT_API_KEY=

# PayNow (store, cart, webhooks). Prefer saving the key in Admin → Settings → Site Settings (encrypted in DB).
# PAYNOW_KEY=

# --- Admin RCON (Rust WebRCON + legacy TCP), see Facepunch webrcon reference:
# https://github.com/Facepunch/webrcon/tree/gh-pages
#
# Your HTTPS admin site is fine: the browser only calls this Laravel API over HTTPS.
# PHP opens a plain ws:// (or legacy TCP) connection from the server to the game — no browser mixed-content issue.
# (A page loaded over https cannot open ws:// from the *browser* to another host; we do not do that.)
#
# RUST_RCON_TIMEOUT_SECONDS=8
# RUST_RCON_FALLBACK_TIMEOUT_SECONDS=4
# Plain WebSocket to Rust (default). Keep false unless the game really uses TLS on the RCON port.
RUST_RCON_WEB_USE_TLS=false
# Optional Origin on the WebSocket upgrade if the game rejects the handshake (try http://localhost)
# RUST_RCON_WEB_ORIGIN=
#
# 502 on /rcon/snapshot? The game must accept TCP from the host that runs PHP (not only from your PC).
# On that host run:  nc -vz RCON_IP RCON_PORT
# Docker: use host IP, published port, or extra_hosts / network_mode so the container can reach the game.

VITE_APP_NAME="${APP_NAME}"
